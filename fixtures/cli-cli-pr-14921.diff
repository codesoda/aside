new file mode 100644
index 00000000000..a169b89e38a
--- /dev/null
+++ b/internal/identity/hardening_test.go
@@ -0,0 +1,96 @@
+package identity
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPersistentIdentityRefusesBareRepositoryWithoutChangingConfig(t *testing.T) {
+	// Given a bare repository where the working-tree identity contract cannot apply
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "--bare", "-q")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+
+	// When attempting a directory binding there
+	err := s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh")
+
+	// Then it fails before installing any global integration
+	require.ErrorContains(t, err, "bare repositories")
+	bindings, err := s.Bindings()
+	require.NoError(t, err)
+	assert.Empty(t, bindings)
+}
+
+func TestPersistentIdentityDoesNotReplaceCustomCredentialHelpers(t *testing.T) {
+	// Given a user's existing HTTPS credential helper for the selected host
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	runGit(t, dir, "config", "--global", "credential.https://github.com.helper", "company-credential-helper")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+
+	// When applying an identity would override the existing helper chain
+	err := s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh")
+
+	// Then the prototype refuses rather than taking ownership of that helper
+	require.ErrorContains(t, err, "existing HTTPS credential helper")
+	assert.Equal(t, "company-credential-helper\n", runGit(t, dir, "config", "--global", "credential.https://github.com.helper"))
+}
+
+func TestCredentialHelperResetAllowsExistingGhSetup(t *testing.T) {
+	// Given a system keychain helper already reset by the user's gh setup
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	system := filepath.Join(dir, "system.gitconfig")
+	require.NoError(t, os.WriteFile(system, []byte("[credential]\nhelper = osxkeychain\n"), 0o600))
+	t.Setenv("GIT_CONFIG_SYSTEM", system)
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "0")
+	runGit(t, dir, "config", "--global", "--add", "credential.https://github.com.helper", "")
+	runGit(t, dir, "config", "--global", "--add", "credential.https://github.com.helper", "!gh auth git-credential")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+
+	// When applying an identity using the already-gh-managed credential setup
+	err := s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh")
+
+	// Then the inactive system helper does not make a valid setup unusable
+	require.NoError(t, err)
+}
+
+func TestPersistentIdentityRefusesSeparateGitDirectory(t *testing.T) {
+	// Given a checkout whose Git metadata is outside the directory tree
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	gitDir := filepath.Join(t.TempDir(), "metadata")
+	runGit(t, dir, "init", "--separate-git-dir", gitDir, "-q")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+
+	// When binding the checkout would not activate its native Git include
+	err := s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh")
+
+	// Then the unsupported layout is rejected instead of giving gh and Git different settings
+	require.ErrorContains(t, err, "separate Git directories")
+}
+
+func TestPersistentIdentityRefusesRepositoryUsingSubmodulesAtSetup(t *testing.T) {
+	// Given a standalone repository whose Git operations may recurse into submodules
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitmodules"), []byte("[submodule \"library\"]\npath = vendor/library\nurl = https://github.com/example/library.git\n"), 0o600))
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+
+	// When applying an identity to that repository
+	err := s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh")
+
+	// Then incompatibility is reported at setup instead of during a later submodule fetch
+	require.ErrorContains(t, err, "repositories that use submodules")
+	bindings, err := s.Bindings()
+	require.NoError(t, err)
+	assert.Empty(t, bindings)
+}
diff --git a/internal/identity/ssh.go b/internal/identity/ssh.go
new file mode 100644
index 00000000000..a11047586a6
--- /dev/null
+++ b/internal/identity/ssh.go
@@ -0,0 +1,157 @@
+package identity
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/kballard/go-shellquote"
+)
+
+// SSHArguments routes a Git SSH invocation through its selected identity's declared alias.
+// It does not authenticate the key or mutate remote URLs or SSH configuration.
+func (s *Store) SSHArguments(args []string, dir string) ([]string, error) {
+	return s.sshArguments(args, dir, "", "")
+}
+
+// SSHArgumentsForAccount selects a declared route for an invocation-local account override.
+// The override applies only to its host and does not change Git attribution or saved choices.
+func (s *Store) SSHArgumentsForAccount(args []string, dir, overrideHost, account string) ([]string, error) {
+	return s.sshArguments(args, dir, overrideHost, account)
+}
+
+func (s *Store) sshArguments(args []string, dir, overrideHost, account string) ([]string, error) {
+	hostIndex := -1
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		if arg == "--" {
+			if i+1 < len(args) {
+				hostIndex = i + 1
+			}
+			break
+		}
+		if !strings.HasPrefix(arg, "-") {
+			hostIndex = i
+			break
+		}
+		if len(arg) == 2 && strings.ContainsAny(arg[1:], "BbcDEeFIiJLlmOoPpQRSWw") {
+			i++
+			if i == len(args) {
+				return nil, fmt.Errorf("SSH option %s requires a value", arg)
+			}
+		}
+	}
+	if hostIndex < 0 {
+		return nil, errors.New("Git SSH invocation is missing its host")
+	}
+	destination := args[hostIndex]
+	user, host, hasUser := strings.Cut(destination, "@")
+	if !hasUser {
+		host = destination
+	}
+	owner := ""
+	if len(args) > hostIndex+1 {
+		command, err := shellquote.Split(args[hostIndex+1])
+		if err != nil {
+			return nil, fmt.Errorf("parse Git SSH command: %w", err)
+		}
+		if len(command) >= 2 {
+			owner, _, _ = strings.Cut(strings.TrimPrefix(command[len(command)-1], "/"), "/")
+		}
+	}
+	var id *Identity
+	var err error
+	if account != "" {
+		id, err = s.accountSSHRoute(host, owner, dir, overrideHost, account)
+	} else {
+		id, err = s.Resolve(host, owner, dir)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if id == nil {
+		return args, nil
+	}
+	if account == "" || !strings.EqualFold(id.Host, overrideHost) {
+		if err := CheckEnvironment(id.Host); err != nil {
+			return nil, err
+		}
+	}
+	if id.SSHHost == "" {
+		return nil, fmt.Errorf("identity %q has no SSH route; run 'gh auth identity edit %s --ssh-host <alias>'", id.Name, id.Name)
+	}
+	result := append([]string(nil), args...)
+	result[hostIndex] = id.SSHHost
+	if hasUser {
+		result[hostIndex] = user + "@" + id.SSHHost
+	}
+	return result, nil
+}
+
+func (s *Store) accountSSHRoute(host, owner, dir, overrideHost, account string) (*Identity, error) {
+	ids, err := s.List()
+	if err != nil {
+		return nil, err
+	}
+	canonical := host
+	known := strings.EqualFold(host, overrideHost)
+	for _, id := range ids {
+		if strings.EqualFold(id.Host, host) {
+			known = true
+		}
+		if !strings.EqualFold(id.SSHHost, host) {
+			continue
+		}
+		if known && !strings.EqualFold(canonical, id.Host) {
+			return nil, fmt.Errorf("SSH host %q is declared for multiple hosts", host)
+		}
+		canonical, known = id.Host, true
+	}
+	if !known {
+		return nil, fmt.Errorf("cannot apply --account to undeclared SSH host %q; declare its route with 'gh auth identity create' or 'gh auth identity edit'", host)
+	}
+	if !strings.EqualFold(canonical, overrideHost) {
+		return s.Resolve(canonical, owner, dir)
+	}
+	routes := map[string]Identity{}
+	candidates := map[string]bool{}
+	for _, id := range ids {
+		if !strings.EqualFold(id.Host, overrideHost) || !strings.EqualFold(id.Account, account) || id.SSHHost == "" {
+			continue
+		}
+		routes[strings.ToLower(id.SSHHost)] = id
+		candidates[id.Name] = true
+	}
+	for _, id := range ids {
+		if _, ok := routes[strings.ToLower(id.SSHHost)]; ok &&
+			(!strings.EqualFold(id.Host, overrideHost) || !strings.EqualFold(id.Account, account)) {
+			return nil, fmt.Errorf("SSH host %q is declared for multiple accounts or hosts; use distinct aliases in 'gh auth identity edit'", id.SSHHost)
+		}
+	}
+	if len(routes) == 0 {
+		return nil, fmt.Errorf("account %q has no declared SSH route on %s; declare one with 'gh auth identity create' or 'gh auth identity edit'", account, host)
+	}
+	if len(routes) == 1 {
+		for _, id := range routes {
+			return &id, nil
+		}
+	}
+	bindings, err := s.Bindings()
+	if err != nil {
+		return nil, err
+	}
+	var matching []Binding
+	for _, binding := range bindings {
+		if candidates[binding.Identity] {
+			matching = append(matching, binding)
+		}
+	}
+	resolution, err := s.resolveBindings(overrideHost, owner, dir, matching)
+	if err != nil {
+		return nil, err
+	}
+	if resolution.Identity != nil {
+		return resolution.Identity, nil
+	}
+	return nil, fmt.Errorf("multiple SSH routes are declared for account %q on %s; apply the intended identity with 'gh auth use'", account, host)
+}
diff --git a/internal/identity/ssh_command.go b/internal/identity/ssh_command.go
new file mode 100644
index 00000000000..23a0840e4d5
--- /dev/null
+++ b/internal/identity/ssh_command.go
@@ -0,0 +1,86 @@
+package identity
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/kballard/go-shellquote"
+)
+
+// SSHCommand resolves the user's connection command underneath gh's managed
+// dispatcher. Override reads the original environment captured by --account.
+// Only the default OpenSSH command is supported; custom connection commands are refused.
+func (s *Store) SSHCommand(dir string, override bool) ([]string, error) {
+	commandEnv, variantEnv := "GIT_SSH_COMMAND", "GIT_SSH_VARIANT"
+	if override {
+		commandEnv, variantEnv = "GH_IDENTITY_SSH_COMMAND", "GH_IDENTITY_SSH_VARIANT"
+	}
+	if os.Getenv(commandEnv) != "" || os.Getenv("GIT_SSH") != "" {
+		return nil, errors.New("custom SSH commands are not supported for identity routing; your SSH configuration has not been changed")
+	}
+	if variant := os.Getenv(variantEnv); variant != "" && variant != "ssh" {
+		return nil, errors.New("custom SSH variants are not supported for identity routing")
+	}
+	for _, key := range []string{"core.sshCommand", "ssh.variant"} {
+		value, err := s.underlyingGitValue(dir, key)
+		if err != nil {
+			return nil, err
+		}
+		if value != "" {
+			return nil, fmt.Errorf("custom %s is not supported for identity routing; your SSH configuration has not been changed", key)
+		}
+	}
+	return []string{"ssh"}, nil
+}
+
+func isSSHDispatcher(command []string) bool {
+	return len(command) == 3 && command[1] == "auth" && command[2] == "git-ssh"
+}
+
+func (s *Store) underlyingGitValue(dir, key string) (string, error) {
+	out, err := gitOptional(dir, "config", "--includes", "--show-origin", "--null", "--get-all", key)
+	if err != nil {
+		return "", err
+	}
+	if out == "" {
+		return "", nil
+	}
+	fields := strings.Split(strings.TrimSuffix(out, "\x00"), "\x00")
+	if len(fields)%2 != 0 {
+		return "", fmt.Errorf("Git did not report origins for %s", key)
+	}
+	value := ""
+	for i := 0; i < len(fields); i += 2 {
+		if sameConfigFile(strings.TrimPrefix(fields[i], "file:"), s.authConfigPath()) {
+			switch key {
+			case "core.sshCommand":
+				command, err := shellquote.Split(fields[i+1])
+				if err != nil || !isSSHDispatcher(command) {
+					return "", errors.New("gh's managed SSH command has been edited; refusing to replace it")
+				}
+			case "ssh.variant":
+				if fields[i+1] != "ssh" {
+					return "", errors.New("gh's managed SSH variant has been edited; refusing to replace it")
+				}
+			}
+			continue
+		}
+		value = fields[i+1]
+	}
+	return value, nil
+}
+
+func sameConfigFile(a, b string) bool {
+	if filepath.Clean(a) == filepath.Clean(b) {
+		return true
+	}
+	first, err := os.Stat(a)
+	if err != nil {
+		return false
+	}
+	second, err := os.Stat(b)
+	return err == nil && os.SameFile(first, second)
+}
diff --git a/internal/identity/ssh_test.go b/internal/identity/ssh_test.go
new file mode 100644
index 00000000000..2e07c49d592
--- /dev/null
+++ b/internal/identity/ssh_test.go
@@ -0,0 +1,57 @@
+package identity
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSSHUsesRepositoryIdentityWithoutChangingRemote(t *testing.T) {
+	// Given an repository identity with an SSH alias
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice", SSHHost: "github-work"}, false))
+	require.NoError(t, s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh"))
+	original := []string{"-o", "SendEnv=GIT_PROTOCOL", "git@github.com", "git-upload-pack 'company/project.git'"}
+
+	// When independently invoked Git dispatches its SSH connection
+	got, err := s.SSHArguments(original, dir)
+
+	// Then only the invocation's SSH host changes, not the canonical URL or input
+	require.NoError(t, err)
+	assert.Equal(t, []string{"-o", "SendEnv=GIT_PROTOCOL", "git@github-work", "git-upload-pack 'company/project.git'"}, got)
+	assert.Equal(t, "git@github.com", original[2])
+}
+
+func TestMissingSSHRouteFailsRatherThanUsingDefaultKey(t *testing.T) {
+	// Given an HTTPS-capable identity without an SSH route
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+	require.NoError(t, s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh"))
+
+	// When Git attempts an SSH operation in that repository
+	_, err := s.SSHArguments([]string{"git@github.com", "git-upload-pack 'company/repo.git'"}, dir)
+
+	// Then routing fails explicitly instead of trying an unrelated default key
+	require.ErrorContains(t, err, "has no SSH route")
+}
+
+func TestSSHPreservesCertificateAuthorityUser(t *testing.T) {
+	// Given an repository identity and GitHub's organization-specific SSH certificate user
+	s := isolatedStore(t)
+	dir := t.TempDir()
+	runGit(t, dir, "init", "-q")
+	require.NoError(t, s.Save(Identity{Name: "work", Host: "github.com", Account: "alice", SSHHost: "github-work"}, false))
+	require.NoError(t, s.Bind(Binding{Identity: "work", Directory: dir}, "/path/to/gh"))
+
+	// When Git connects using the server-supplied SSH URL
+	got, err := s.SSHArguments([]string{"org-1234@github.com", "git-upload-pack 'company/project.git'"}, dir)
+
+	// Then identity routing changes the host without changing the SSH certificate user
+	require.NoError(t, err)
+	assert.Equal(t, "org-1234@github-work", got[0])
+}

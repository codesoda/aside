+package use
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/internal/config"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/identity"
+	"github.com/cli/cli/v2/pkg/cmdutil"
+	"github.com/cli/cli/v2/pkg/iostreams"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUseDoesNotSaveScopeWhenGlobalIncludeCannotBeInstalled(t *testing.T) {
+	// Given a saved identity and another writer holding Git's global config lock
+	store, f := useFixture(t)
+	require.NoError(t, store.Save(identity.Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+	t.Chdir(t.TempDir())
+	familyGit(t, ".", "init", "-q")
+	require.NoError(t, os.WriteFile(os.Getenv("GIT_CONFIG_GLOBAL")+".lock", nil, 0o600))
+	cmd := NewCmdUse(f, nil)
+	cmd.SetOut(f.IOStreams.ErrOut)
+	cmd.SetErr(f.IOStreams.ErrOut)
+	cmd.SetArgs([]string{"work"})
+
+	// When applying the identity without being able to configure independently invoked Git
+	err := cmd.Execute()
+
+	// Then setup fails and no gh-only scope is left behind
+	require.ErrorContains(t, err, "could not lock config file")
+	assert.NoFileExists(t, filepath.Join(os.Getenv("GH_CONFIG_DIR"), "auth.gitconfig"))
+	choices, err := store.Bindings()
+	require.NoError(t, err)
+	assert.Empty(t, choices)
+}
+
+func useFixture(t *testing.T) (*identity.Store, *cmdutil.Factory) {
+	t.Helper()
+	if runtime.GOOS == "windows" {
+		t.Skip("persistent identities are not supported on Windows")
+	}
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("GH_CONFIG_DIR", filepath.Join(home, "gh"))
+	t.Setenv("GIT_CONFIG_GLOBAL", filepath.Join(home, ".gitconfig"))
+	t.Setenv("GIT_CONFIG_NOSYSTEM", "1")
+	for _, key := range []string{"GH_TOKEN", "GITHUB_TOKEN", "GIT_DIR", "GIT_WORK_TREE", "GIT_SSH", "GIT_SSH_COMMAND", "GIT_SSH_VARIANT", "GH_IDENTITY_SSH_COMMAND", "GH_IDENTITY_SSH_VARIANT", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL"} {
+		t.Setenv(key, "")
+		require.NoError(t, os.Unsetenv(key))
+	}
+	cfg := config.NewMockConfigFromString("hosts:\n  github.com:\n    users:\n      alice:\n      bob:\n")
+	ios, _, _, _ := iostreams.Test()
+	store, err := identity.Open()
+	require.NoError(t, err)
+	return store, &cmdutil.Factory{
+		IOStreams: ios, ExecutablePath: "/path/to/gh",
+		Config: func() (gh.Config, error) { return cfg, nil },
+	}
+}
+
+func runUse(t *testing.T, f *cmdutil.Factory, args ...string) string {
+	t.Helper()
+	ios, _, stdout, stderr := iostreams.Test()
+	factory := *f
+	factory.IOStreams = ios
+	cmd := NewCmdUse(&factory, nil)
+	cmd.SetOut(stderr)
+	cmd.SetErr(stderr)
+	cmd.SetArgs(args)
+	require.NoError(t, cmd.Execute(), "%s", stderr.String())
+	return stdout.String()
+}
+
+func TestUseViewShowsSelectionWithoutChangingIt(t *testing.T) {
+	// Given an identity selected for a directory
+	store, f := useFixture(t)
+	require.NoError(t, store.Save(identity.Identity{Name: "work", Host: "github.com", Account: "alice"}, false))
+	t.Chdir(t.TempDir())
+	familyGit(t, ".", "init", "-q")
+	runUse(t, f, "work")
+
+	// When explicitly viewing the selection
+	output := runUse(t, f, "--view")
+
+	// Then it is the same JSON as bare auth use, and later inspection is unchanged
+	assert.JSONEq(t, `{"name":"work","host":"github.com","account":"alice"}`, output)
+	assert.Equal(t, output, runUse(t, f))
+}
+
+func TestUseViewRejectsOtherActions(t *testing.T) {
+	for _, args := range [][]string{
+		{"--view", "work"}, {"--view", "--unset"}, {"--view", "--list"},
+	} {
+		t.Run(strings.Join(args, " "), func(t *testing.T) {
+			// Given an explicit view combined with another action
+			ios, _, _, _ := iostreams.Test()
+			cmd := NewCmdUse(&cmdutil.Factory{IOStreams: ios}, nil)
+			cmd.SetArgs(args)
+			cmd.SilenceUsage, cmd.SilenceErrors = true, true
+
+			// When parsing that command
+			err := cmd.Execute()
+
+			// Then it fails before reading or changing configuration
+			require.ErrorContains(t, err, "--view cannot be combined")
+		})
+	}
+}
diff --git a/pkg/cmd/auth/use/worktrees_test.go b/pkg/cmd/auth/use/worktrees_test.go
new file mode 100644
index 00000000000..591227be58c
--- /dev/null
+++ b/pkg/cmd/auth/use/worktrees_test.go
@@ -0,0 +1,98 @@
+package use
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/internal/identity"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func familyGit(t *testing.T, dir string, args ...string) string {
+	t.Helper()
+	cmd := exec.Command("git", append([]string{"-C", dir}, args...)...)
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, "%s", out)
+	return strings.TrimSpace(string(out))
+}
+
+func TestUseFromAnyWorktreeSelectsEntireRepositoryFamily(t *testing.T) {
+	// Given a main checkout, an external linked worktree, and an unrelated nested repository
+	s, f := useFixture(t)
+	main := t.TempDir()
+	familyGit(t, main, "init", "-q")
+	familyGit(t, main, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.test",
+		"-c", "commit.gpgsign=false", "commit", "--allow-empty", "-qm", "initial")
+	linked := filepath.Join(t.TempDir(), "linked")
+	familyGit(t, main, "worktree", "add", "--detach", linked)
+	nested := filepath.Join(main, "unrelated")
+	require.NoError(t, os.Mkdir(nested, 0o700))
+	familyGit(t, nested, "init", "-q")
+	for _, id := range []identity.Identity{
+		{Name: "work", Host: "github.com", Account: "alice", SSHHost: "work-ssh"},
+		{Name: "personal", Host: "github.com", Account: "bob", SSHHost: "personal-ssh"},
+	} {
+		require.NoError(t, s.Save(id, false))
+	}
+	t.Chdir(linked)
+
+	// When choosing an identity from a linked worktree and creating another worktree later
+	runUse(t, f, "work")
+	future := filepath.Join(t.TempDir(), "future")
+	familyGit(t, main, "worktree", "add", "--detach", future)
+
+	// Then all family members share gh selection and SSH routing, but not the nested repo
+	for _, dir := range []string{main, linked, future} {
+		var selected identity.Identity
+		require.NoError(t, json.Unmarshal([]byte(runUse(t, f, "--view", "--directory", dir)), &selected))
+		assert.Equal(t, "work", selected.Name)
+		args, err := s.SSHArguments([]string{"git@github.com", "git-upload-pack 'company/project.git'"}, dir)
+		require.NoError(t, err)
+		assert.Equal(t, "git@work-ssh", args[0])
+	}
+	assert.JSONEq(t, "null", runUse(t, f, "--view", "--directory", nested))
+	var bindings []map[string]any
+	require.NoError(t, json.Unmarshal([]byte(runUse(t, f, "--list")), &bindings))
+	require.Len(t, bindings, 1)
+	assert.Equal(t, familyGit(t, main, "rev-parse", "--path-format=absolute", "--git-common-dir"), bindings[0]["repository"])
+	assert.NotContains(t, bindings[0], "directory")
+
+	// When applying from another family member, the same choice changes everywhere
+	runUse(t, f, "personal", "--directory", future)
+	require.NoError(t, json.Unmarshal([]byte(runUse(t, f, "--list")), &bindings))
+	require.Len(t, bindings, 1)
+	runUse(t, f, "--unset", "--directory", main)
+	assert.JSONEq(t, "null", runUse(t, f, "--view", "--directory", linked))
+}
+
+func TestFamilySetupDoesNotIgnoreSiblingSSHOverride(t *testing.T) {
+	// Given a sibling worktree with an explicit SSH command that bypasses the global dispatcher
+	s, f := useFixture(t)
+	main := t.TempDir()
+	familyGit(t, main, "init", "-q")
+	familyGit(t, main, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.test", "-c", "commit.gpgsign=false", "commit", "--allow-empty", "-qm", "initial")
+	linked := filepath.Join(t.TempDir(), "linked")
+	familyGit(t, main, "worktree", "add", "--detach", linked)
+	familyGit(t, main, "config", "extensions.worktreeConfig", "true")
+	familyGit(t, linked, "config", "--worktree", "core.sshCommand", "ssh -F sibling.conf")
+	require.NoError(t, s.Save(identity.Identity{Name: "work", Host: "github.com", Account: "alice", SSHHost: "work-ssh"}, false))
+	t.Chdir(main)
+	cmd := NewCmdUse(f, nil)
+	cmd.SilenceUsage, cmd.SilenceErrors = true, true
+	cmd.SetArgs([]string{"work"})
+
+	// When setup from the main checkout would claim to configure the entire family
+	err := cmd.Execute()
+
+	// Then it fails without changing sibling settings or installing a misleading family choice
+	require.ErrorContains(t, err, "core.sshCommand")
+	assert.Equal(t, "ssh -F sibling.conf", familyGit(t, linked, "config", "core.sshCommand"))
+	bindings, err := s.Bindings()
+	require.NoError(t, err)
+	assert.Empty(t, bindings)
+}
